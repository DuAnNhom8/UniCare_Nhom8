# Sao chép file thành backend/.env rồi sửa mật khẩu MySQL thật.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=unicareer_db
# Tùy chọn: DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/unicareer_db?charset=utf8mb4

# Bắt buộc cho chức năng đăng nhập / ứng tuyển. Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Tùy chọn: nơi lưu CV riêng tư (không nằm trong frontend)
# CV_STORAGE_DIR=/absolute/private/path
